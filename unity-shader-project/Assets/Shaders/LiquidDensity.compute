#pragma kernel ClearAccumulation
#pragma kernel RasterizeDrops
#pragma kernel ResolveDensity

#define VELOCITY_SCALE 4096.0
#define MAX_ENCODED_VELOCITY 800.0
#define MAX_VELOCITY_RATIO 8.0

StructuredBuffer<float4> _DropData;
StructuredBuffer<float> _DropRadii;
StructuredBuffer<float4> _DropColors;
StructuredBuffer<float4> _DropSwapPaths;
RWStructuredBuffer<int4> _Accumulation;
RWStructuredBuffer<int3> _ColorAccumulation;
RWStructuredBuffer<uint> _DominantColorKeys;
RWTexture2D<float4> _DensityOutput;
RWTexture2D<float4> _ColorOutput;
RWTexture2D<float4> _SharpColorOutput;

int _TextureWidth;
int _TextureHeight;
int _PixelCount;
int _DropCount;
float4 _ScreenBounds;
float _XScale;
float _YScale;
float _DensityContribution;
float _TailSpeedForMaximumLength;

[numthreads(256, 1, 1)]
void ClearAccumulation(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_PixelCount)
    {
        return;
    }

    _Accumulation[dispatchId.x] = int4(0, 0, 0, 0);
    _ColorAccumulation[dispatchId.x] = int3(0, 0, 0);
    _DominantColorKeys[dispatchId.x] = 0;
}

[numthreads(8, 8, 1)]
void RasterizeDrops(uint3 groupId : SV_GroupID, uint3 threadId : SV_GroupThreadID)
{
    uint dropIndex = groupId.x;
    if (dropIndex >= (uint)_DropCount)
    {
        return;
    }

    float4 drop = _DropData[dropIndex];
    float2 position = drop.xy;
    float2 velocity = drop.zw;
    float dropRadius = _DropRadii[dropIndex];
    float4 dropColor = _DropColors[dropIndex];
    bool transitioning = dropColor.a < 1.0;
    float2 transitionStart = position;
    if (transitioning)
    {
        float progress = saturate(dropColor.a);
        progress = progress * progress * (3.0 - 2.0 * progress);
        float4 swapPath = _DropSwapPaths[dropIndex];
        transitionStart = swapPath.xy;
        position = lerp(swapPath.xy, swapPath.zw, progress);
    }

    float supportRadius = dropRadius * 2.2;
    float inverseSupportRadiusSquared = 1.0 / (supportRadius * supportRadius);
    float speed = length(velocity);
    bool hasDirection = speed > 0.001;
    float2 direction = hasDirection ? velocity / speed : 0.0;
    float tailLength = hasDirection
        ? dropRadius * 2.5 * saturate(speed / _TailSpeedForMaximumLength)
        : 0.0;
    float2 velocityRatio = clamp(
        velocity / MAX_ENCODED_VELOCITY,
        -MAX_VELOCITY_RATIO,
        MAX_VELOCITY_RATIO);
    int2 center = (int2)round((position - _ScreenBounds.xy) * float2(_XScale, _YScale));
    float2 radii = (supportRadius + tailLength) * float2(_XScale, _YScale);
    float majorRadius = supportRadius + tailLength * 0.5;
    float inverseMajorRadiusSquared = 1.0 / (majorRadius * majorRadius);
    int2 firstPixel = max(int2(0, 0), (int2)floor(center - radii));
    int2 lastPixel = min(
        int2(_TextureWidth - 1, _TextureHeight - 1),
        (int2)ceil(center + radii));
    float2 transitionSegment = position - transitionStart;
    float transitionSegmentLengthSquared = dot(transitionSegment, transitionSegment);
    if (transitioning)
    {
        float2 startCenter =
            (transitionStart - _ScreenBounds.xy) * float2(_XScale, _YScale);
        float2 bridgeRadii = supportRadius * float2(_XScale, _YScale);
        firstPixel = max(
            int2(0, 0),
            min(firstPixel, (int2)floor(startCenter - bridgeRadii)));
        lastPixel = min(
            int2(_TextureWidth - 1, _TextureHeight - 1),
            max(lastPixel, (int2)ceil(startCenter + bridgeRadii)));
    }

    for (int tileY = firstPixel.y; tileY <= lastPixel.y; tileY += 8)
    {
        for (int tileX = firstPixel.x; tileX <= lastPixel.x; tileX += 8)
        {
            int2 pixel = int2(tileX, tileY) + int2(threadId.xy);
            if (pixel.x > lastPixel.x || pixel.y > lastPixel.y)
            {
                continue;
            }

            float2 offset = (float2(pixel - center)) / float2(_XScale, _YScale);
            float normalizedDistanceSquared;
            if (hasDirection)
            {
                float along = dot(offset, direction) + tailLength * 0.5;
                float across = -offset.x * direction.y + offset.y * direction.x;
                normalizedDistanceSquared = along * along * inverseMajorRadiusSquared
                    + across * across * inverseSupportRadiusSquared;
            }
            else
            {
                normalizedDistanceSquared = dot(offset, offset) * inverseSupportRadiusSquared;
            }

            float contribution = 0.0;
            if (normalizedDistanceSquared < 1.0)
            {
                float remaining = 1.0 - normalizedDistanceSquared;
                contribution = _DensityContribution * remaining * remaining;
            }

            if (transitioning && transitionSegmentLengthSquared > 0.0001)
            {
                float2 worldPosition = position + offset;
                float segmentProgress = saturate(
                    dot(worldPosition - transitionStart, transitionSegment)
                        / transitionSegmentLengthSquared);
                float2 nearestPathPosition = transitionStart
                    + transitionSegment * segmentProgress;
                float2 bridgeOffset = worldPosition - nearestPathPosition;
                float bridgeDistanceSquared =
                    dot(bridgeOffset, bridgeOffset) * inverseSupportRadiusSquared;
                if (bridgeDistanceSquared < 1.0)
                {
                    float bridgeRemaining = 1.0 - bridgeDistanceSquared;
                    float bridgeContribution =
                        _DensityContribution * bridgeRemaining * bridgeRemaining;
                    contribution = max(contribution, bridgeContribution);
                }
            }

            if (contribution <= 0.0)
            {
                continue;
            }

            int densityIncrement = (int)round(contribution * 255.0);
            int weight = (int)round(contribution * VELOCITY_SCALE);
            int velocityX = (int)round(velocityRatio.x * contribution * VELOCITY_SCALE);
            int velocityY = (int)round(velocityRatio.y * contribution * VELOCITY_SCALE);
            int colorR = (int)round(dropColor.r * contribution * VELOCITY_SCALE);
            int colorG = (int)round(dropColor.g * contribution * VELOCITY_SCALE);
            int colorB = (int)round(dropColor.b * contribution * VELOCITY_SCALE);
            uint pixelIndex = (uint)(pixel.y * _TextureWidth + pixel.x);
            int ignored;
            InterlockedAdd(_Accumulation[pixelIndex].x, densityIncrement, ignored);
            InterlockedAdd(_Accumulation[pixelIndex].y, weight, ignored);
            InterlockedAdd(_Accumulation[pixelIndex].z, velocityX, ignored);
            InterlockedAdd(_Accumulation[pixelIndex].w, velocityY, ignored);
            InterlockedAdd(_ColorAccumulation[pixelIndex].x, colorR, ignored);
            InterlockedAdd(_ColorAccumulation[pixelIndex].y, colorG, ignored);
            InterlockedAdd(_ColorAccumulation[pixelIndex].z, colorB, ignored);
            uint colorPriority = (uint)round(saturate(contribution) * 65535.0);
            uint dominantColorKey = (colorPriority << 16) | (65535u - dropIndex);
            uint ignoredDominantColorKey;
            InterlockedMax(
                _DominantColorKeys[pixelIndex],
                dominantColorKey,
                ignoredDominantColorKey);
        }
    }
}

[numthreads(8, 8, 1)]
void ResolveDensity(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_TextureWidth || dispatchId.y >= (uint)_TextureHeight)
    {
        return;
    }

    uint pixelIndex = dispatchId.y * _TextureWidth + dispatchId.x;
    int4 accumulated = _Accumulation[pixelIndex];
    float2 encodedVelocity = accumulated.y > 0
        ? clamp((float2)accumulated.zw / accumulated.y, -1.0, 1.0)
        : 0.0;
    _DensityOutput[dispatchId.xy] = float4(
        min(accumulated.x, 255) / 255.0,
        round((encodedVelocity * 0.5 + 0.5) * 255.0) / 255.0,
        accumulated.y > 0 ? 1.0 : 0.0);
    int3 colorAccumulated = _ColorAccumulation[pixelIndex];
    float4 liquidColor = accumulated.y > 0
        ? float4(
            saturate((float)colorAccumulated.x / accumulated.y),
            saturate((float)colorAccumulated.y / accumulated.y),
            saturate((float)colorAccumulated.z / accumulated.y),
            1.0)
        : float4(0.16, 0.5, 0.95, 1.0);
    _ColorOutput[dispatchId.xy] = liquidColor;

    uint dominantColorKey = _DominantColorKeys[pixelIndex];
    uint dominantDropIndex = 65535u - (dominantColorKey & 65535u);
    float4 sharpLiquidColor = accumulated.y > 0 && dominantDropIndex < (uint)_DropCount
        ? float4(_DropColors[dominantDropIndex].rgb, 1.0)
        : float4(0.16, 0.5, 0.95, 1.0);
    _SharpColorOutput[dispatchId.xy] = sharpLiquidColor;
}
