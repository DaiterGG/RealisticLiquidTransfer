<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RealisticLiquidTransfer</AssemblyName>
    <RootNamespace>RealisticLiquidTransfer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GamePath Condition="'$(GamePath)' == ''">D:\SteamLibrary\steamapps\common\Casualties Unknown</GamePath>
    <EnableDebugLogging Condition="'$(EnableDebugLogging)' == ''">false</EnableDebugLogging>
    <EnableDebugLaunch Condition="'$(EnableDebugLaunch)' == ''">false</EnableDebugLaunch>
    <EnableProfiling Condition="'$(EnableProfiling)' == ''">false</EnableProfiling>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableDebugLogging)' == 'true'">
    <DefineConstants>$(DefineConstants);LIQUID_TRANSFER_DEBUG_LOGGING</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableDebugLaunch)' == 'true'">
    <DefineConstants>$(DefineConstants);LIQUID_TRANSFER_DEBUG_LAUNCH</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableProfiling)' == 'true'">
    <DefineConstants>$(DefineConstants);LIQUID_TRANSFER_PROFILING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="LiquidTransferMinigame.cs" />
    <Compile Include="HandAlphaGradient.cs" />
    <Compile Include="DebugLog.cs" />
    <Compile Include="SimulationProfiler.cs" />
    <Compile Include="LiquidSimulation.cs" />
    <Compile Include="LiquidDensityCatalog.cs" />
    <Compile Include="LiquidShaderAssets.cs" />
    <Compile Include="ContainerShapeCollision.cs" />
    <Compile Include="ModSprites.cs" />
    <Compile Include="MultiplayerTransferBridge.cs" />
    <Compile Include="Patches.cs" />
    <Compile Include="DebugLaunchSetup.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="resources\*.png">
      <LogicalName>RealisticLiquidTransfer.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="resources\*.bundle">
      <LogicalName>RealisticLiquidTransfer.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(GamePath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GamePath)\CasualtiesUnknown_Data\Managed\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
